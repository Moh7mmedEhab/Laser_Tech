# Copy to .env (dev) and .env.test (tests) and fill real values.
NODE_ENV=development
# If DIRECT_DATABASE_URL is set in production, Prisma uses it for migrate CLI.
# DATABASE_URL: Neon POOLED connection string (host contains -pooler)
DATABASE_URL=postgresql://user:password@ep-xxxx-pooler.region.aws.neon.tech/lasertech?sslmode=require
# DIRECT_DATABASE_URL: direct (non-pooler) URL used only by migration CLI
DIRECT_DATABASE_URL=
# Comma-separated allowlist; include the frontend dev URL
CORS_ORIGINS=http://localhost:5173
# openssl rand -base64 48
COOKIE_SECRET=replace-with-a-random-64-plus-char-string

# Copy to .env (dev) and .env.test (tests) and fill real values.
NODE_ENV=development
# Neon POOLED connection string for the app runtime (host contains -pooler)
DATABASE_URL=postgresql://user:password@ep-xxxx-pooler.region.aws.neon.tech/lasertech?sslmode=require
# Neon DIRECT connection string used only by Prisma CLI (label: "unpooled")
DIRECT_URL=postgresql://user:password@ep-xxxx.region.aws.neon.tech/lasertech?sslmode=require
# Comma-separated allowlist; include the frontend dev URL
CORS_ORIGINS=http://localhost:5173
# openssl rand -base64 64
COOKIE_SECRET=replace-with-a-random-64-plus-char-string

# Main admin credentials for `npm run seed -w apps/backend`
# (seed defaults come from here; CLI flags override)
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@lasertech.com
ADMIN_PHONE=+201000000000
ADMIN_PASSWORD=replace-with-a-strong-password

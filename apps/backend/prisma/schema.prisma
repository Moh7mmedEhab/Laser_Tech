// Prisma schema for the Laser Tech API. Apply with `npm run migrate:dev`.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  USER
  EMPLOYEE
}

model User {
  id           String   @id @default(cuid())
  username     String   @unique
  email        String   @unique
  phone        String   @unique
  passwordHash String
  role         Role     @default(USER)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  sessions        Session[]
  loginHistory    LoginHistory[]
  bills           Bill[]           @relation("BillOwner")
  billsCreated    Bill[]           @relation("BillCreator")
  notesAuthored   Note[]           @relation("NoteAuthor")
  notesAbout      Note[]           @relation("NoteSubject")

  @@index([role])
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  tokenHash String   @unique
  userAgent String?
  ip        String?
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model LoginHistory {
  id        String   @id @default(cuid())
  userId    String
  ip        String?
  userAgent String?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

model Product {
  id        String   @id @default(cuid())
  name      String
  sku       String   @unique
  category  String   @default("General")
  price     Decimal  @db.Decimal(12, 2)
  quantity  Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  billItems BillItem[]

  @@index([category])
}

model Bill {
  id        String   @id @default(cuid())
  userId    String
  adminId   String
  notes     String?
  amount    Decimal  @db.Decimal(12, 2)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user  User       @relation("BillOwner", fields: [userId], references: [id])
  admin User       @relation("BillCreator", fields: [adminId], references: [id])
  items BillItem[]

  @@index([userId])
  @@index([adminId])
  @@index([createdAt])
}

model BillItem {
  id         String  @id @default(cuid())
  billId     String
  productId  String
  quantity   Int
  unitPrice  Decimal @db.Decimal(12, 2)

  bill     Bill    @relation(fields: [billId], references: [id], onDelete: Cascade)
  product  Product @relation(fields: [productId], references: [id])

  @@unique([billId, productId])
}

model Note {
  id        String   @id @default(cuid())
  adminId   String
  userId    String?
  content   String
  amount    Decimal? @db.Decimal(12, 2)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  admin User    @relation("NoteAuthor", fields: [adminId], references: [id])
  user  User?   @relation("NoteSubject", fields: [userId], references: [id])

  @@index([adminId])
  @@index([userId])
  @@index([createdAt])
}
